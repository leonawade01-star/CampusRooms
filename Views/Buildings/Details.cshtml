@model Building

<h1>@Model.Name</h1>

@if (Model.Rooms.Count == 0)
{
    <p>No rooms in @Model.Name yet</p>
}
else
{
    <table class="table">
        <tr>
            <th>Code</th>
            <th>Name</th>
            <th>Seats</th>
        </tr>
        @foreach (Room each_room in Model.Rooms.OrderBy(room => room.Code))
        {
            <tr>
                <td><a asp-controller="Rooms" asp-action="Details" asp-route-id="@each_room.Id">@each_room.Code</a></td>
                <td>@each_room.Name</td>
                <td>@each_room.Seats</td>
            </tr>
        }
    </table>
}

<a asp-controller="Rooms" asp-action="Index">All rooms</a>