@model List<Room>

<h1>Rooms</h1>
<p>@ViewBag.Count rooms</p>

@if (User.IsInRole("Admin") || User.IsInRole("Staff"))
{
    <a class="btn btn-primary mb-3" asp-controller="Rooms" asp-action="Add">Add a room</a>
}

<table class="table">
    <tr>
        <th>Code</th>
        <th>Name</th>
        <th>Seats</th>
        <th>Building</th>
        <th>Projector</th>
        <th></th>
    </tr>
    @foreach (Room each_room in Model)
    {
        <partial name="_RoomRow" model="each_room" />
    }
</table>